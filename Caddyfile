# The load balancer in front of the two API replicas. It takes turns between
# them and, while one is being restarted, retries the other, so a client never
# notices the restart. That is what a rolling restart relies on.
:80 {
	reverse_proxy api_1:8000 api_2:8000 {
		lb_policy round_robin
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 3s
		health_uri /health
		health_interval 1s
		health_timeout 1s
	}
}
